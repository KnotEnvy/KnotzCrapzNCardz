# Repo-wide ignores. Each game may add its own alongside this one — a nested
# .gitignore anchors its leading-slash rules to its own folder, so the craps
# app's rules keep working from TableGames/craps.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
build/
dist/

# testing
coverage/

# typescript
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and credentials — never commit these
.env*
*.pem
*.key

# editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# local agent scratch
.claude/settings.local.json
